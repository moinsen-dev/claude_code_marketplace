{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "moinsen-claude-code-marketplace",
  "version": "1.4.0",
  "owner": {
    "name": "Ulrich Diedrichsen",
    "url": "https://github.com/moinsen-dev"
  },
  "metadata": {
    "description": "Custom Claude Code plugin marketplace with specialized tools and workflows",
    "version": "1.1.0",
    "homepage": "https://github.com/moinsen-dev/claude_code_marketplace"
  },
  "plugins": [
    {
      "name": "dev-tools",
      "source": "./plugins/dev-tools",
      "description": "Essential development tools and utilities for common coding tasks",
      "version": "1.0.0",
      "author": {
        "name": "Ulrich Diedrichsen",
        "email": "[email protected]"
      },
      "keywords": ["development", "tools", "utilities", "productivity"],
      "category": "development"
    },
    {
      "name": "file-guardian",
      "source": "./plugins/file-guardian",
      "description": "Protect sensitive files from accidental edits and prevent unnecessary markdown summaries with configurable blacklists",
      "version": "1.1.0",
      "author": {
        "name": "Ulrich Diedrichsen",
        "email": "[email protected]"
      },
      "keywords": [
        "security",
        "file-protection",
        "blacklist",
        "safety",
        "automation"
      ],
      "category": "security"
    },
    {
      "name": "code-quality-guardian",
      "source": "./plugins/code-quality-guardian",
      "description": "Prevent bloated files and incomplete code by detecting oversized files and TODO comments, suggesting refactoring and complete implementations",
      "version": "1.1.0",
      "author": {
        "name": "Ulrich Diedrichsen",
        "email": "[email protected]"
      },
      "keywords": [
        "code-quality",
        "refactoring",
        "architecture",
        "best-practices",
        "file-size",
        "domain-driven-design"
      ],
      "category": "quality"
    }
  ]
}
